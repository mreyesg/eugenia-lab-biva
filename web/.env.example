# Copia este archivo como .env.local para pruebas con "vercel dev".
# En produccion, estas variables se configuran en el panel de Vercel
# (Project Settings -> Environment Variables), NUNCA se suben al repositorio.

# Clave de la API de Claude (obligatoria). Se obtiene en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar (opcional). Por defecto: claude-sonnet-5
# Para maxima calidad (mas caro): claude-opus-4-8
# CLAUDE_MODEL=claude-sonnet-5

# Correo de contacto para OpenAlex (opcional, pero recomendado por etiqueta de la API).
# OPENALEX_MAILTO=tu-correo@upr.edu
